  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">

  <style>
    /* ===========================================================
       MailCapital Design Tokens & Theme Matching
    =========================================================== */
    :root {
      --ink:            #14171F;   /* deep charcoal navy */
      --ink-soft:       #1D212C;
      --ink-line:       #2A2F3B;
      --paper:          #EFEDE2;   /* receipt paper */
      --paper-raised:   #FAF9F3;
      --paper-line:     #D9D5C6;
      --ink-text:       #1B1D22;
      --ink-text-70:    rgba(27,29,34,.7);
      --paper-text-70:  rgba(239,237,226,.72);
      --flash:          #FF5A36;   /* packaging-tape orange-red */
      --flash-dark:     #E14A29;
      --grow:           #3FBE83;   /* growth mint-green */

      --font-display:   "Space Grotesk", sans-serif;
      --font-body:      "Inter", sans-serif;
      --font-mono:      "JetBrains Mono", monospace;
      --radius:         14px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--ink-soft);
      color: var(--ink-text);
      font-family: var(--font-body);
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      padding: 40px 0;
    }

    /* ===========================================================
       A4 PAGE ARCHITECTURE (210mm x 297mm)
    =========================================================== */
    .a4-page {
      width: 210mm;
      min-height: 297mm;
      height: 297mm;
      margin: 0 auto 30px;
      background: var(--paper);
      padding: 16mm 18mm;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.45);
      page-break-after: always;
      overflow: hidden;
    }

    /* Running Header & Footer */
    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--paper-line);
      padding-bottom: 10px;
      margin-bottom: 14px;
    }
    .page-header__logo {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 16px;
      color: var(--ink-text);
      text-decoration: none;
    }
    .page-header__logo-img {
      width: 22px;
      height: 22px;
      object-fit: contain;
      display: block;
    }
    .page-header__tag {
      font-family: var(--font-mono);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--ink-text-70);
      font-weight: 600;
    }

    .page-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--paper-line);
      padding-top: 10px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--ink-text-70);
    }

    .page-content {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    /* Typography Utilities */
    h1, h2, h3, h4 {
      font-family: var(--font-display);
      color: var(--ink-text);
      letter-spacing: -0.01em;
      line-height: 1.15;
    }
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--flash-dark);
      margin-bottom: 6px;
      font-weight: 700;
      display: inline-block;
    }
    .section-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
    }
    .section-desc {
      font-size: 13px;
      color: var(--ink-text-70);
      line-height: 1.45;
      margin-bottom: 14px;
    }

    /* Structured Components & Grid */
    .grid-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .card {
      background: var(--paper-raised);
      border: 1px solid var(--paper-line);
      border-radius: 12px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 12px rgba(20, 23, 31, 0.03);
    }
    .card__head {
      font-family: var(--font-display);
      font-size: 14.5px;
      font-weight: 700;
      color: var(--ink-text);
      margin-bottom: 10px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--paper-line);
    }

    /* Key-Value Row Alignment Fix */
    .card-rows {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .card-row {
      display: grid;
      grid-template-columns: 125px 1fr;
      gap: 10px;
      align-items: baseline;
      font-size: 11.5px;
      line-height: 1.35;
    }
    .card-row__label {
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--ink-text);
      position: relative;
      padding-left: 10px;
    }
    .card-row__label::before {
      content: "•";
      position: absolute;
      left: 0;
      top: 0;
      color: var(--flash);
      font-size: 13px;
      font-weight: bold;
    }
    .card-row__val {
      color: var(--ink-text-70);
    }

    /* Metric Banner */
    .metric-banner {
      background: var(--ink);
      color: var(--paper);
      border-radius: var(--radius);
      padding: 14px 18px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-bottom: 14px;
    }
    .metric-val {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: #FFFFFF;
      line-height: 1;
      margin-bottom: 4px;
    }
    .metric-val--flash { color: var(--flash); }
    .metric-val--grow { color: var(--grow); }
    .metric-lbl {
      font-family: var(--font-mono);
      font-size: 9.5px;
      color: var(--paper-text-70);
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    /* Tables */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 11.5px;
      background: var(--paper-raised);
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--paper-line);
      margin-bottom: 12px;
    }
    .data-table th {
      background: rgba(20, 23, 31, 0.04);
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      text-align: left;
      padding: 8px 12px;
      border-bottom: 1px solid var(--paper-line);
      color: var(--ink-text);
      text-transform: uppercase;
      letter-spacing: .05em;
    }
    .data-table td {
      padding: 8px 12px;
      border-bottom: 1px solid var(--paper-line);
      color: var(--ink-text-70);
      vertical-align: top;
      line-height: 1.35;
    }
    .data-table tr:last-child td { border-bottom: none; }

    /* Cover Page */
    .cover-page {
      background: var(--ink);
      color: var(--paper);
      justify-content: space-between;
      position: relative;
    }
    .cover-page::before {
      content: "";
      position: absolute;
      top: -15%;
      right: -15%;
      width: 320mm;
      height: 320mm;
      background: radial-gradient(circle, rgba(255,90,54,.22) 0%, transparent 60%);
      pointer-events: none;
    }
    .cover-page .page-header { border-color: rgba(255, 255, 255, 0.12); }
    .cover-page .page-header__logo { color: var(--paper); }
    .cover-page .page-header__tag { color: var(--paper-text-70); }
    .cover-page .page-footer { border-color: rgba(255, 255, 255, 0.12); color: rgba(239,237,226,.45); }
    
    .cover-title {
      font-size: 44px;
      font-weight: 700;
      color: #FFFFFF;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 14px 0 18px;
    }
    .cover-subtitle {
      font-size: 16px;
      color: var(--paper-text-70);
      line-height: 1.5;
      max-width: 500px;
      margin-bottom: 28px;
    }
    .cover-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      padding: 18px;
      border-radius: var(--radius);
    }
    .cover-meta-item strong {
      display: block;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--flash);
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 3px;
    }
    .cover-meta-item span {
      font-size: 13px;
      color: #FFFFFF;
    }

    /* Print & Export Rules */
    @media print {
      body {
        background: transparent;
        padding: 0;
      }
      .a4-page {
        margin: 0;
        box-shadow: none;
        page-break-after: always;
        width: 100%;
        height: 100vh;
        min-height: auto;
      }
      @page {
        size: A4 portrait;
        margin: 0;
      }
    }
  </style>
</head>
